    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
