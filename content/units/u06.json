{
  "id": "u06",
  "number": 6,
  "title": "Essen & Trinken",
  "grammar": "Akkusativ, Teil 1: weiblich -a → -u",
  "tips": [
    {
      "id": "tip-u06-acc",
      "title": "Kava wird zu kavu",
      "text": "Was du trinkst, isst oder möchtest, steht im Akkusativ. Bei weiblichen Wörtern auf -a wird daraus -u: kava → Pijem kavu. Männliche Dinge und sächliche Wörter bleiben gleich: Pijem čaj. Pijem pivo.",
      "examples": [["Pijem kavu.", "Ich trinke Kaffee."], ["Pijem čaj.", "Ich trinke Tee."], ["Pijem pivo.", "Ich trinke Bier."]]
    },
    {
      "id": "tip-u06-eat",
      "title": "Essen und Nicht-Essen",
      "text": "jesti (essen) ist unregelmäßig: jedem, jedeš, jede. Für „kein“ sagst du einfach „ne“ vor das Verb: Ne jedem meso – Ich esse kein Fleisch.",
      "examples": [["Jedem ribu.", "Ich esse Fisch."], ["Ne jedem meso.", "Ich esse kein Fleisch."], ["Jedeš li salatu?", "Isst du Salat?"]]
    },
    {
      "id": "tip-u06-want",
      "title": "Ich möchte …",
      "text": "želim heißt „ich möchte“, hoću „ich will“. Danach kommt einfach die Grundform: Želim jesti. Kroatisch sagt nicht „Želim da jedem“ – das ist Serbisch.",
      "examples": [["Želim kavu.", "Ich möchte einen Kaffee."], ["Želim jesti.", "Ich möchte essen."], ["Hoću piti vodu.", "Ich will Wasser trinken."]]
    },
    {
      "id": "tip-u06-table",
      "title": "Am Tisch",
      "text": "Vor dem Essen wünscht man „Dobar tek!“, beim Anstoßen ruft man „Živjeli!“. Wer satt ist, sagt als Mann „Sit sam“, als Frau „Sita sam“.",
      "examples": [["Dobar tek!", "Guten Appetit!"], ["Živjeli!", "Prost!"], ["Hvala, sit sam.", "Danke, ich bin satt."]]
    },
    {
      "id": "tip-u06-cafe",
      "title": "Im Café",
      "text": "„Može“ ist ein Zauberwort: Može kava? – Wie wär's mit Kaffee? Antwort: Može! – Gerne! Nach zwei, drei, vier wird -a zu -e: dvije šalice kave.",
      "examples": [["Može kava?", "Lust auf einen Kaffee?"], ["Može!", "Gerne!"], ["Račun, molim.", "Die Rechnung, bitte."]]
    },
    {
      "id": "tip-u06-oma",
      "title": "Bei Oma",
      "text": "Bei Oma wird gekocht: kuhati – kuham, kuhaš, kuha. „volim“ bedeutet hier „ich mag“: Volim piletinu. Auch danach steht der Akkusativ.",
      "examples": [["Baka kuha ručak.", "Oma kocht Mittagessen."], ["Volim piletinu.", "Ich mag Hähnchen."], ["Volim voće.", "Ich mag Obst."]]
    }
  ],
