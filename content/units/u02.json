{
  "id": "u02",
  "number": 2,
  "title": "Hallo!",
  "grammar": "„se“ an zweiter Stelle; ti und Vi",
  "tips": [
    {
      "id": "tip-u02-greet",
      "title": "Grüßen wie zu Hause",
      "text": "„Bok“ ist locker – für Familie und Freunde, zum Kommen und Gehen. Zu Fremden und Älteren sagst du „Dobar dan“. Beachte: dobar dan, aber dobro jutro und dobra večer – das Wort für „gut“ passt sich an.",
      "examples": [["Bok!", "Hallo! / Tschüss!"], ["Dobar dan!", "Guten Tag!"], ["Dobra večer!", "Guten Abend!"]]
    },
    {
      "id": "tip-u02-kako",
      "title": "Kako si?",
      "text": "Wörtlich heißt „Kako si?“ „Wie bist du?“. Die Antwort heißt oft einfach „Dobro“ oder „Dobro sam“. Mit „A ti?“ fragst du zurück – das „a“ bedeutet hier „und“.",
      "examples": [["Kako si?", "Wie geht's?"], ["Dobro, a ti?", "Gut, und dir?"]]
    },
    {
      "id": "tip-u02-se",
      "title": "Kleine Wörter an Platz 2",
      "text": "Kurze Wörter wie se, sam, si, je stehen immer an zweiter Stelle im Satz – nie am Anfang. Im Deutschen sagt man „Ich heiße Ana“, im Kroatischen „Zovem se Ana“ oder „Ja se zovem Ana“. Falsch wäre „Se zovem Ana“.",
      "examples": [["Zovem se Ana.", "Ich heiße Ana."], ["Ja se zovem Ana.", "Ich heiße Ana."], ["Kako se zoveš?", "Wie heißt du?"]]
    },
    {
      "id": "tip-u02-iz",
      "title": "Woher? – iz …",
      "text": "Nach „iz“ (aus) ändert sich das Ende des Ortsnamens. Für Namen auf -a merkst du dir erst einmal: -a wird zu -e. Mehr dazu lernst du später beim Genitiv.",
      "examples": [["Njemačka → iz Njemačke", "aus Deutschland"], ["Bosna → iz Bosne", "aus Bosnien"], ["Hrvatska → iz Hrvatske", "aus Kroatien"]]
    },
    {
      "id": "tip-u02-vi",
      "title": "Du oder Sie?",
      "text": "Wie im Deutschen gibt es „ti“ (du) und „Vi“ (Sie). In der Familie und unter Freunden sagt man „ti“. „Vi“ nimmst du für Fremde und ältere Menschen, die du nicht gut kennst. Das Verb steht dann in der ihr-Form: Kako ste? – Wie geht es Ihnen?",
      "examples": [["Kako si?", "Wie geht's dir?"], ["Kako ste?", "Wie geht es Ihnen?"], ["Oprosti! / Oprostite!", "Entschuldige! / Entschuldigen Sie!"]]
    }
  ],
