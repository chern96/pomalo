  "title": "Aussprache & Alphabet",
  "grammar": "Laute im Vergleich zum Deutschen, ije/je",
  "tips": [
    {
      "id": "tip-u01-basics",
      "title": "Wie man schreibt, so spricht man",
      "text": "Im Kroatischen steht jeder Buchstabe für genau einen Laut – und er wird immer gleich ausgesprochen. Die Vokale a, e, i, o, u klingen wie im Deutschen, nur etwas kürzer. Es gibt keine stummen Buchstaben.",
      "examples": [["mama", "Mama"], ["voda", "Wasser"], ["more", "Meer"]]
    },
    {
      "id": "tip-u01-czsh",
      "title": "c, z, s, h – Vorsicht, Falle!",
      "text": "Diese vier sehen deutsch aus, klingen aber anders: c ist das deutsche z (wie in „Zeit“), z ist ein summendes s (wie in „Sonne“), s ist immer scharf (wie in „Haus“), und h klingt wie ch in „Bach“.",
      "examples": [["otac", "Vater"], ["jezik", "Sprache"], ["sestra", "Schwester"], ["kruh", "Brot"]]
    },
    {
      "id": "tip-u01-hacek",
      "title": "Häkchen und Striche",
      "text": "č klingt wie „tsch“, š wie „sch“ und ž wie das j in „Journal“. ć klingt fast wie č, nur weicher. Die Sprachausgabe unterscheidet č und ć kaum – merke dir die Schreibweise mit dem Wort.",
      "examples": [["čaj", "Tee"], ["šećer", "Zucker"], ["žena", "Frau"], ["kuća", "Haus"]]
    },
    {
      "id": "tip-u01-j",
      "title": "j, lj, nj, dž, đ",
      "text": "j klingt wie das deutsche j in „ja“. lj und nj sind je ein Laut: ein l bzw. n, mit j verschmolzen (wie „Kognak“ für nj). dž klingt wie in „Dschungel“, đ fast genauso, nur weicher – auch hier hilft die Schreibweise.",
      "examples": [["ja", "ich"], ["ljubav", "Liebe"], ["Njemačka", "Deutschland"], ["džem", "Marmelade"], ["rođak", "Cousin"]]
    },
    {
      "id": "tip-u01-ije",
      "title": "Rollendes r und „ije“",
      "text": "Das r wird mit der Zungenspitze gerollt und kann sogar allein eine Silbe bilden: srce, crkva, Hrvatska. Kroatisch schreibt oft „ije“ oder „je“, wo Serbisch nur „e“ hat: mlijeko statt mleko. Für dich gilt immer die Form mit „ije“.",
      "examples": [["srce", "Herz"], ["Hrvatska", "Kroatien"], ["mlijeko", "Milch"], ["dijete", "Kind"]]
    }
  ],
