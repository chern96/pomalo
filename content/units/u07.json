{
  "id": "u07",
  "number": 7,
  "title": "Was machst du?",
  "grammar": "Präsens: -ati / -iti / -jeti / -ovati",
  "tips": [
    {
      "id": "tip-u07-ati",
      "title": "Verben auf -ati",
      "text": "Die meisten Verben auf -ati sind ganz regelmäßig: -ati fällt weg, dann kommen die Endungen. čitati → čitam (ich lese), čitaš (du liest), čita (er/sie liest), čitamo (wir), čitate (ihr), čitaju (sie). „Ich“ und „du“ kannst du weglassen – die Endung sagt schon, wer es ist.",
      "examples": [["Čitam knjigu.", "Ich lese ein Buch."], ["Gledamo film.", "Wir schauen einen Film."], ["Beba spava.", "Das Baby schläft."]]
    },
    {
      "id": "tip-u07-iti",
      "title": "Verben auf -iti",
      "text": "Bei Verben auf -iti heißen die Endungen -im, -iš, -i, -imo, -ite, -e. raditi → radim (ich arbeite), radiš, radi, radimo, radite, rade. „Što radiš?“ heißt sowohl „Was machst du gerade?“ als auch „Was arbeitest du?“.",
      "examples": [["Radim u uredu.", "Ich arbeite im Büro."], ["Što radiš?", "Was machst du?"], ["Djeca uče.", "Die Kinder lernen."]]
    },
    {
      "id": "tip-u07-jeti",
      "title": "Verben auf -jeti",
      "text": "Verben auf -jeti gehen meistens wie die auf -iti: vidjeti → vidim, vidiš, vidi … Du kennst schon zwei davon: voljeti → volim und živjeti → živim. Auch sjediti (sitzen) geht so: sjedim, sjediš, sjedi.",
      "examples": [["Vidim mamu.", "Ich sehe Mama."], ["Baka sjedi u kuhinji.", "Oma sitzt in der Küche."], ["Volim kuhinju.", "Ich mag die Küche."]]
    },
    {
      "id": "tip-u07-govoriti",
      "title": "Sprechen & Verstehen",
      "text": "govoriti → govorim (ich spreche), znati → znam (ich weiß). razumjeti ist besonders: razumijem, razumiješ, razumije – mit „ije“. Sprachen schreibt man klein: hrvatski, njemački.",
      "examples": [["Govorim malo hrvatski.", "Ich spreche ein bisschen Kroatisch."], ["Ne razumijem.", "Ich verstehe nicht."], ["Ne znam.", "Ich weiß nicht."]]
    },
    {
      "id": "tip-u07-ovati",
      "title": "Verben auf -ovati und ići",
      "text": "Aus -ovati wird -ujem: putovati → putujem, putuješ, putuje … kupovati → kupujem. Das wichtige Verb ići (gehen, fahren) ist unregelmäßig: idem, ideš, ide, idemo, idete, idu.",
      "examples": [["Putujem u Bosnu.", "Ich reise nach Bosnien."], ["Mama kupuje kruh.", "Mama kauft Brot."], ["Idem kući.", "Ich gehe nach Hause."]]
    }
  ],
