{
  "id": "u05",
  "number": 5,
  "title": "Zahlen & Alter",
  "grammar": "imati (haben); 1 godina / 2–4 godine / 5+ godina",
  "tips": [
    {
      "id": "tip-u05-small",
      "title": "Eins bis fünf",
      "text": "„eins“ passt sich an wie ein Adjektiv: jedan brat, jedna sestra, jedno dijete. Für „zwei“ gibt es zwei Wörter: dva für männliche und sächliche Wörter, dvije für weibliche. Nach 2, 3 und 4 ändert sich das Nomen: dva brata, tri sestre.",
      "examples": [["dva brata", "zwei Brüder"], ["dvije sestre", "zwei Schwestern"], ["tri sestre", "drei Schwestern"]]
    },
    {
      "id": "tip-u05-ten",
      "title": "Sechs bis zehn",
      "text": "šest, sedam, osam, devet, deset – diese Zahlen ändern sich nie. Merke: „sedam“ klingt fast wie „sieben“, „deset“ fast wie „zehn“.",
      "examples": [["šest", "6"], ["sedam", "7"], ["deset", "10"]]
    },
    {
      "id": "tip-u05-naest",
      "title": "11 bis 19: -naest",
      "text": "Die Zahlen von 11 bis 19 enden auf -naest (wie „-zehn“): jedanaest, dvanaest, trinaest, četrnaest, petnaest, šesnaest, sedamnaest, osamnaest, devetnaest. Achtung: 14 und 16 sind leicht verkürzt.",
      "examples": [["četrnaest", "14"], ["šesnaest", "16"], ["devetnaest", "19"]]
    },
    {
      "id": "tip-u05-tens",
      "title": "Zehner, hundert, tausend",
      "text": "Die Zehner enden auf -deset: dvadeset, trideset, četrdeset, pedeset, šezdeset, sedamdeset, osamdeset, devedeset. Anders als im Deutschen kommt der Zehner zuerst: trideset pet = 35. 100 ist sto, 1000 ist tisuća (nicht „hiljada“).",
      "examples": [["trideset pet", "35"], ["sto", "100"], ["tisuća", "1000"]]
    },
    {
      "id": "tip-u05-age",
      "title": "Wie alt bist du?",
      "text": "Das Alter sagt man mit „haben“: Imam 30 godina – wörtlich „Ich habe 30 Jahre“. Die Form von godina hängt von der Zahl ab: 1 godina, 2 bis 4 godine, ab 5 godina. Bei 21, 22 … zählt die letzte Ziffer.",
      "examples": [["Imam trideset godina.", "Ich bin 30 Jahre alt."], ["Ima tri godine.", "Er/Sie ist drei Jahre alt."], ["Koliko imaš godina?", "Wie alt bist du?"]]
    }
  ],
