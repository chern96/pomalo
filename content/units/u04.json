{
  "id": "u04",
  "number": 4,
  "title": "Familie",
  "grammar": "Geschlecht der Nomen; moj/moja/moje",
  "tips": [
    {
      "id": "tip-u04-gender",
      "title": "Der, die, das – ohne Artikel",
      "text": "Kroatisch hat keine Artikel. Das Geschlecht erkennst du meist an der Endung: Konsonant = männlich (brat), -a = weiblich (majka), -o oder -e = sächlich (selo, dijete). „mein“ passt sich an: moj brat, moja majka, moje dijete.",
      "examples": [["moj brat", "mein Bruder"], ["moja majka", "meine Mutter"], ["moje dijete", "mein Kind"]]
    },
    {
      "id": "tip-u04-tvoj",
      "title": "Mein und dein",
      "text": "„dein“ funktioniert genau wie „mein“: tvoj (männlich), tvoja (weiblich), tvoje (sächlich). Ausnahmen beim Geschlecht gibt es: tata und djed sind männlich, obwohl tata auf -a endet.",
      "examples": [["tvoj djed", "dein Opa"], ["tvoja baka", "deine Oma"], ["moj tata", "mein Papa"]]
    },
    {
      "id": "tip-u04-uncle",
      "title": "Welcher Onkel?",
      "text": "Kroatisch unterscheidet, von welcher Seite ein Onkel kommt: stric ist der Bruder des Vaters, ujak der Bruder der Mutter. teta ist die Tante. rođak und rođakinja sind Cousin und Cousine.",
      "examples": [["stric", "Bruder des Vaters"], ["ujak", "Bruder der Mutter"], ["teta", "Tante"]]
    },
    {
      "id": "tip-u04-djeca",
      "title": "Ein Kind, viele Kinder",
      "text": "dijete (Kind) hat eine unregelmäßige Mehrzahl: djeca. „Verheiratet“ hängt vom Geschlecht ab: ein Mann ist oženjen, eine Frau ist udana.",
      "examples": [["dijete → djeca", "Kind → Kinder"], ["Oženjen sam.", "Ich bin verheiratet. (Mann)"], ["Udana sam.", "Ich bin verheiratet. (Frau)"]]
    },
    {
      "id": "tip-u04-tko",
      "title": "Wer ist das?",
      "text": "Kroatisch fragt „Tko je to?“ – nicht „Ko je to?“ (das ist Serbisch oder Bosnisch). „dieser“ passt sich wieder an: ovaj (m), ova (f), ovo (n).",
      "examples": [["Tko je to?", "Wer ist das?"], ["ova žena", "diese Frau"], ["ovaj čovjek", "dieser Mann"]]
    },
    {
      "id": "tip-u04-adj",
      "title": "Groß und klein",
      "text": "Auch Adjektive richten sich nach dem Nomen: velik grad, velika kuća, veliko selo. Bei „klein“ hört man meistens die Form mali, mala, malo.",
      "examples": [["velika obitelj", "große Familie"], ["mali brat", "kleiner Bruder"], ["malo dijete", "kleines Kind"]]
    }
  ],
