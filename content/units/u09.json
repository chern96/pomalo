{
  "id": "u09",
  "number": 9,
  "title": "Fragen stellen",
  "grammar": "tko, što, gdje, kada, kako, zašto, koliko; je li / da li",
  "tips": [
    {
      "id": "tip-u09-tko",
      "title": "Wer? Was? Welcher?",
      "text": "tko = wer, što = was. Umgangssprachlich hörst du oft „šta“ – in Kroatien schreibt man „što“. koji (welcher) und čiji (wessen) passen sich an wie Adjektive: koji film, koja knjiga, čiji pas, čija torba.",
      "examples": [["Tko je to?", "Wer ist das?"], ["Što je ovo?", "Was ist das?"], ["Čiji je ovo pas?", "Wessen Hund ist das?"]]
    },
    {
      "id": "tip-u09-gdje",
      "title": "Wo? Wohin? Wann?",
      "text": "gdje = wo, kamo = wohin, kada (oder kurz kad) = wann. Wie im Deutschen unterscheidet man „wo“ und „wohin“: Gdje si? – Wo bist du? Kamo ideš? – Wohin gehst du? Bei „nikad“ (nie) bleibt das „ne“ trotzdem: Nikad ne jedem meso.",
      "examples": [["Gdje je mama?", "Wo ist Mama?"], ["Kamo ideš?", "Wohin gehst du?"], ["Kada ideš kući?", "Wann gehst du nach Hause?"]]
    },
    {
      "id": "tip-u09-zasto",
      "title": "Warum? – Weil …",
      "text": "zašto = warum. Die Antwort beginnt mit „zato što“ oder „jer“ (beide: weil). Anders als im Deutschen rutscht das Verb nicht ans Ende: … jer sam bolestan (… weil ich krank bin). Und die wichtigste Frage beim Lernen: Kako se kaže …? – Wie sagt man …?",
      "examples": [["Zašto ne jedeš?", "Warum isst du nicht?"], ["Zato što sam umoran.", "Weil ich müde bin."], ["Kako se kaže „Danke“?", "Wie sagt man „Danke“?"]]
    },
    {
      "id": "tip-u09-jeli",
      "title": "Ja-oder-Nein-Fragen",
      "text": "Für Ja/Nein-Fragen kommt „li“ hinter das Verb: Imaš li …? Govoriš li …? Mit „ist“ heißt es „Je li …?“. In Bosnien und Serbien hört man oft „Da li je …?“ – das ist umgangssprachlich, im Kroatischen sagt man „Je li …?“.",
      "examples": [["Je li to istina?", "Ist das wahr?"], ["Je li baka kod kuće?", "Ist Oma zu Hause?"], ["Kava ili čaj?", "Kaffee oder Tee?"]]
    },
    {
      "id": "tip-u09-neugierig",
      "title": "Neugierig sein",
      "text": "kakav (was für ein, wie) passt sich an: kakav film, kakva kava, kakvo vrijeme. „vrijeme“ heißt Zeit und Wetter: Kakvo je vrijeme? – Wie ist das Wetter? Imaš li vremena? – Hast du Zeit?",
      "examples": [["Što ima novo?", "Was gibt's Neues?"], ["Kakvo je vrijeme?", "Wie ist das Wetter?"], ["Imaš li vremena?", "Hast du Zeit?"]]
    }
  ],
